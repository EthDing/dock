{
  "name": "dock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "dock": "dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.74",
    "@anthropic-ai/sdk": "0.121.0",
    "@dock/tui": "workspace:*",
    "fast-glob": "3.3.3",
    "openai": "7.5.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter @dock/tui build && tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter @dock/tui typecheck",
    "ci": "pnpm check && pnpm test && pnpm build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run && pnpm --filter @dock/tui test",
    "test:sandbox": "DOCK_SANDBOX_INTEGRATION=1 vitest run test/sandbox/sandbox-integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
